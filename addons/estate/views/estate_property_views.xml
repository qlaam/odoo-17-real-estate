<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_view_tree" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state in ['sold', 'canceled']" decoration-success="state in ['offer_received', 'offer_accepted']" decoration-bf="state == 'offer_accepted'">
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="best_price"/>
                <field name="selling_price"/>
                <field name="date_availability" optional="hide"/>
                <field name="salesperson_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_sold" type="object" string="Sold" class="oe_highlight" invisible="state != 'offer_accepted'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ['sold', 'canceled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Property name"/></h1></div>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <group>
                        <group>
                            <field name="property_type_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the property..."/>
                            <group>
                                <group>
                                    <field name="bedrooms"/>
                                    <field name="living_area"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                </group>
                                <group>
                                    <field name="garden"/>
                                    <field name="garden_area" invisible="not garden"/>
                                    <field name="garden_orientation" invisible="not garden"/>
                                    <field name="total_area"/>
                                </group>
                            </group>
                        </page>
                        <page string="Offers" name="offers">
                            <field name="offer_ids" readonly="state in ['offer_accepted', 'sold', 'canceled']" context="{'default_property_id': id}">
                                <tree editable="bottom" decoration-success="status == 'accepted'" decoration-danger="status == 'refused'">
                                    <field name="price" readonly="status"/>
                                    <field name="partner_id" readonly="status"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <field name="status"/>
                                    <button name="action_accept" type="object" icon="fa-check" title="Accept offer" invisible="status or parent.state not in ['new', 'offer_received']"/>
                                    <button name="action_refuse" type="object" icon="fa-times" title="Refuse offer" invisible="status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Other Info" name="other_info">
                            <group><field name="salesperson_id"/><field name="buyer_id"/></group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Properties">
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area" filter_domain="[('living_area', '&gt;=', self)]"/>
                <field name="salesperson_id"/>
                <filter name="available" string="Available" domain="[('state', 'in', ['new', 'offer_received'])]"/>
                <filter name="my_properties" string="My Properties" domain="[('salesperson_id', '=', uid)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_postcode" string="Postcode" context="{'group_by': 'postcode'}"/>
                    <filter name="group_type" string="Property Type" context="{'group_by': 'property_type_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_salesperson" string="Salesperson" context="{'group_by': 'salesperson_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id" quick_create="false" records_draggable="false" groups_draggable="false">
                <field name="name"/><field name="state"/>
                <field name="expected_price"/><field name="best_price"/><field name="selling_price"/>
                <field name="living_area"/><field name="postcode"/>
                <field name="tag_ids"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <div><field name="postcode"/></div>
                            <div>Expected price: <field name="expected_price"/></div>
                            <div t-if="record.state.raw_value == 'offer_received'">Best offer: <field name="best_price"/></div>
                            <div t-if="['offer_accepted', 'sold'].includes(record.state.raw_value)">Selling price: <field name="selling_price"/></div>
                            <div>Living area: <field name="living_area"/> sqm</div>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <div class="mt-2"><field name="state" widget="label_selection"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="estate_property_view_search"/>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Create your first property</p></field>
    </record>
</odoo>
