<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_property_view_form_account" model="ir.ui.view">
        <field name="name">estate.property.form.account</field>
        <field name="model">estate.property</field>
        <field name="inherit_id" ref="estate.estate_property_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Invoicing" groups="account.group_account_invoice" invisible="not invoice_id">
                    <field name="invoice_id" readonly="1" options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
